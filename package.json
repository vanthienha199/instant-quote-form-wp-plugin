{
  "name": "instant-quote-form",
  "private": true,
  "scripts": {
    "env:start": "wp-env start",
    "env:stop": "wp-env stop",
    "test:setup": "wp-env run tests-cli --env-cwd=wp-content/iqf-dev composer install --no-interaction --quiet",
    "test": "wp-env run tests-cli --env-cwd=wp-content/iqf-dev vendor/bin/phpunit",
    "zip": "rm -f dist/instant-quote-form.zip && mkdir -p dist && zip -qr dist/instant-quote-form.zip instant-quote-form -x '*.DS_Store'"
  },
  "devDependencies": { "@wordpress/env": "^10.0.0" }
}
